# Keycloak (self-hosted via Docker + a cloudflared quick tunnel) used by
# /mcp-server-delegated for real per-user RFC 8693 token exchange, in place
# of Auth0's Custom Token Exchange -- which requires a paid Auth0 plan this
# tenant doesn't have. Ephemeral: the trycloudflare.com hostname changes
# whenever the tunnel or container restarts, so these need updating then.
KEYCLOAK_ISSUER=http://<tunnel-host>/realms/mcp-demo
KEYCLOAK_JWKS_URL=https://<tunnel-host>/realms/mcp-demo/protocol/openid-connect/certs
KEYCLOAK_INBOUND_AUDIENCE=gateway-inbound-client
KEYCLOAK_TOKEN_URL=https://<tunnel-host>/realms/mcp-demo/protocol/openid-connect/token
KEYCLOAK_DOWNSTREAM_AUDIENCE=downstream-api
KEYCLOAK_CLIENT_ID=gateway-inbound-client
KEYCLOAK_CLIENT_SECRET=
