{
  "policies": [
    {
      "name": "require-bearer-with-prm-hint",
      "policyType": "custom-code-inbound",
      "handler": {
        "export": "default",
        "module": "$import(./modules/require-bearer-with-prm-hint)",
        "options": {}
      }
    },
    {
      "name": "mcp-jwt-auth-inbound",
      "policyType": "oauth-inbound",
      "handler": {
        "export": "OpenIdJwtInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "issuer": "$env(KEYCLOAK_ISSUER)",
          "jwkUrl": "$env(KEYCLOAK_JWKS_URL)",
          "audience": "$env(KEYCLOAK_INBOUND_AUDIENCE)"
        }
      }
    },
    {
      "name": "token-exchange-inbound",
      "policyType": "custom-code-inbound",
      "handler": {
        "export": "default",
        "module": "$import(./modules/token-exchange)",
        "options": {}
      }
    }
  ]
}
